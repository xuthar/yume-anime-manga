/* Bind to the owner's spreadsheet. No spreadsheet ID or owner secret is published. */
const YUME_SITE='https://xuthar.github.io/yume-anime-manga/';
const YUME_RAW='https://raw.githubusercontent.com/xuthar/yume-anime-manga/main/';
const YUME_LOG='Acquisti Yume';
function onOpen(){SpreadsheetApp.getUi().createMenu('Yume').addItem('Collega questo browser','showYumeConnection').addToUi()}
function setupYume(){
 const ss=SpreadsheetApp.getActiveSpreadsheet(),active=Session.getActiveUser().getEmail(),effective=Session.getEffectiveUser().getEmail();if(!ss||!active||active!==effective||ss.getOwner().getEmail()!==active)throw Error('Accesso riservato al proprietario.');
 const p=PropertiesService.getScriptProperties();if(p.getProperty('OWNER')&&p.getProperty('OWNER')!==active)throw Error('Proprietario diverso.');p.setProperties({SHEET_ID:ss.getId(),OWNER:active});if(!p.getProperty('OWNER_KEY'))p.setProperty('OWNER_KEY',Utilities.getUuid()+Utilities.getUuid());
 if(!ss.getSheetByName(YUME_LOG)){const sh=ss.insertSheet(YUME_LOG);sh.getRange(1,1,1,5).setValues([['ID operazione','Identità volume','Acquistato il','Dati volume verificati','Opera']]);sh.setFrozenRows(1);sh.getRange(1,1,1,5).setBackground('#202236').setFontColor('#ffffff').setFontWeight('bold');sh.setColumnWidths(1,3,190);sh.setColumnWidth(4,350);sh.setColumnWidth(5,260);sh.getRange('D:D').setWrap(true)}
 try{onOpen()}catch{}return 'Collegamento preparato; nessun volume aggiunto.';
}
function verifyYumeSetup(){
 requireOwner_();const ss=sheet_();if(!ss.getSheetByName(YUME_LOG)||!ss.getSheetByName('Manga e novel')||!ss.getSheetByName('Volumi in possesso'))throw Error('Schede della collezione mancanti.');
 const response=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+ss.getId()+'?fields=spreadsheetId',{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});if(response.getResponseCode()!==200)throw Error('Google Sheets API non disponibile: '+response.getResponseCode()+' · '+response.getContentText().slice(0,500));
 if(!Array.isArray(fetchJson_('library.json').items)||!Array.isArray(fetchJson_('data/book-calendar.json').releases)||!Array.isArray(fetchJson_('data/book-calendar-history.json').observations))throw Error('Catalogo o storico non disponibili.');
 console.log('Verifica riuscita: Google Sheets API, catalogo e storico raggiungibili. Nessun acquisto aggiunto.');return true;
}
function showYumeConnection(){
 const p=PropertiesService.getScriptProperties();if(!p.getProperty('OWNER_KEY'))setupYume();requireOwner_();const url=ScriptApp.getService().getUrl();if(!url)throw Error('Pubblica prima la web app.');
 const payload=Utilities.base64Encode(JSON.stringify({endpoint:url,token:p.getProperty('OWNER_KEY')}));const target=YUME_SITE+'mie-liste.html#yume-owner='+payload;
 SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput('<p>Collega esclusivamente il tuo browser personale. Il carrello aggiornerà la collezione e i due fogli dei manga.</p><p><a style="display:inline-block;padding:12px;background:#202236;color:white;border-radius:8px;text-decoration:none" target="_blank" rel="noreferrer" href="'+target+'">Attiva gli acquisti di Xuthar</a></p><p>Non condividere questo collegamento.</p>').setWidth(440).setHeight(220),'Collega Yume');
}
function requireOwner_(){const p=PropertiesService.getScriptProperties();if(!Session.getActiveUser().getEmail()||Session.getActiveUser().getEmail()!==p.getProperty('OWNER'))throw Error('Accesso riservato al proprietario.')}
function sheet_(){return SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID'))}
function records_(){const sh=sheet_().getSheetByName(YUME_LOG);return sh&&sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,5).getValues().map(r=>{try{return {...JSON.parse(r[3]),requestId:r[0]}}catch{return null}}).filter(Boolean):[]}
function output_(data,callback){const json=JSON.stringify(data).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');return ContentService.createTextOutput(callback&&/^yumePurchase_[a-zA-Z0-9_]+$/.test(callback)?callback+'('+json+');':json).setMimeType(callback?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON)}
function doGet(e){try{const q=e.parameter||{};if(q.action==='status'){if(!/^[a-f0-9-]{36}$/.test(q.id||''))return output_({status:'error',message:'Operazione non valida.'},q.callback);const alias=CacheService.getScriptCache().get('receipt:'+q.id);const record=records_().find(r=>r.requestId===q.id)||(alias?JSON.parse(alias):null);const error=CacheService.getScriptCache().get('error:'+q.id);return output_(record?{status:'ok',record}:error?{status:'error',message:error}:{status:'pending'},q.callback)}return output_({records:records_(),updatedAt:new Date().toISOString()},q.callback)}catch{return output_({records:[],status:'unavailable'},e.parameter?.callback)}}
function doPost(e){let request;try{request=JSON.parse(e.postData.contents);const stored=PropertiesService.getScriptProperties().getProperty('OWNER_KEY');let different=!stored||typeof request.token!=='string'||request.token.length!==stored.length;if(!different){let diff=0;for(let i=0;i<stored.length;i++)diff|=stored.charCodeAt(i)^request.token.charCodeAt(i);different=!!diff}if(different)return output_({status:'denied'});if(!/^[a-f0-9-]{36}$/.test(request.requestId||''))throw Error('Operazione non valida.');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const result=register_(request);return output_({status:'ok',record:result})}finally{lock.releaseLock()}}catch(err){if(request?.requestId&&/^[a-f0-9-]{36}$/.test(request.requestId))CacheService.getScriptCache().put('error:'+request.requestId,'Acquisto non sincronizzato: '+String(err.message||'errore').slice(0,180),600);return output_({status:'error'})}}
function fetchJson_(path){const cache=CacheService.getScriptCache(),k='json:'+path;const old=cache.get(k);if(old)return JSON.parse(old);const response=UrlFetchApp.fetch(YUME_RAW+path,{muteHttpExceptions:true});if(response.getResponseCode()!==200)throw Error('Catalogo non raggiungibile.');const text=response.getContentText();if(text.length<90000)cache.put(k,text,60);return JSON.parse(text)}
function enrich_(book){
 const isbn=YumeCollection.isbn(book.isbn||(book.url.match(/(?:978|979)\d{10}/)||[])[0]);if(!isbn)return {};try{const resp=UrlFetchApp.fetch('https://www.googleapis.com/books/v1/volumes?q=isbn:'+encodeURIComponent(isbn)+'&maxResults=3',{muteHttpExceptions:true});if(resp.getResponseCode()!==200)return {};const match=(JSON.parse(resp.getContentText()).items||[]).find(x=>(x.volumeInfo.industryIdentifiers||[]).some(i=>YumeCollection.isbn(i.identifier)===isbn));if(!match)return {};const v=match.volumeInfo;return {author:(v.authors||[]).join(' · '),image:(v.imageLinks?.thumbnail||'').replace(/^http:/,'https:'),synopsis:String(v.description||'').replace(/<[^>]+>/g,' ').slice(0,650),source:v.infoLink?.replace(/^http:/,'https:')||'https://books.google.com/books?id='+encodeURIComponent(match.id)}}catch{return {}};
}
function value_(v){return v===null||v===undefined?{}:{userEnteredValue:typeof v==='number'?{numberValue:v}:{stringValue:String(v)}}}
function formula_(s){return {userEnteredValue:{formulaValue:s}}}
function cell_(sh,row,col,v){return {updateCells:{start:{sheetId:sh.getSheetId(),rowIndex:row-1,columnIndex:col-1},rows:[{values:[v]}],fields:'userEnteredValue'}}}
function row_(sh,row,values,requests){if(row>sh.getMaxRows())requests.push({appendDimension:{sheetId:sh.getSheetId(),dimension:'ROWS',length:Math.max(100,row-sh.getMaxRows())}});if(sh.getLastRow()>1)requests.push({copyPaste:{source:{sheetId:sh.getSheetId(),startRowIndex:1,endRowIndex:2,startColumnIndex:0,endColumnIndex:values.length},destination:{sheetId:sh.getSheetId(),startRowIndex:row-1,endRowIndex:row,startColumnIndex:0,endColumnIndex:values.length},pasteType:'PASTE_FORMAT'}});requests.push({updateCells:{start:{sheetId:sh.getSheetId(),rowIndex:row-1,columnIndex:0},rows:[{values:values.map(v=>v&&v.userEnteredValue?v:value_(v))}],fields:'userEnteredValue'}})}
function register_(request){
 const previous=records_(),old=previous.find(r=>r.requestId===request.requestId||r.key===request.book?.key);if(old){if(old.requestId!==request.requestId)CacheService.getScriptCache().put('receipt:'+request.requestId,JSON.stringify(old),600);return old}
 let b=YumeCollection.identify(request.book||{});if(!b.title||b.title.length>400||!b.number||b.number.length>30||!['IT','EN'].includes(b.language)||!['manga','novel'].includes(b.kind))throw Error('Indica opera, lingua e numero del volume.');
 const release=[...fetchJson_('data/book-calendar.json').releases,...fetchJson_('data/book-calendar-history.json').observations.map(o=>o.entry)].find(x=>YumeCollection.key(x)===b.key);if(!release)throw Error('Edizione non trovata nel calendario.');
 b={...release,number:b.number,series:b.series,editionTitle:b.editionTitle,workId:b.workId,key:b.key,purchasedAt:new Date().toISOString()};b=YumeCollection.identify(b);
 const base=fetchJson_('library.json').items.filter(x=>x.type==='manga'),before=YumeCollection.merge(base,previous),existing=YumeCollection.find(before,b);if(b.workId&&!existing)throw Error('Opera da verificare.');b.workId=existing?.id||'';b.metadata=existing?{}:enrich_(b);
 const after=YumeCollection.merge(before,[b]),work=YumeCollection.find(after,b);b.workId=work.id;
 const ss=sheet_(),works=ss.getSheetByName('Manga e novel'),volumes=ss.getSheetByName('Volumi in possesso'),log=ss.getSheetByName(YUME_LOG);if(!works||!volumes||!log)throw Error('Schede della collezione non disponibili.');
 const rows=works.getRange(2,1,Math.max(1,works.getLastRow()-1),19).getValues();const id=work.id.startsWith('manga-ac-')?work.id.slice(9):work.id;let index=rows.findIndex(r=>String(r[15])===id);if(index<0&&existing)index=rows.findIndex(r=>YumeCollection.norm(r[0])===YumeCollection.norm(existing.title));let row=index<0?works.getLastRow()+1:index+2;if(index>=0){b.baseOwned=Number(rows[index][2])||0;b.baseNumbers=String(rows[index][4]||'')}
 const requests=[];const already=existing?.volumes.some(v=>YumeCollection.sameVolume(v,b,existing));
 if(!already){row_(volumes,volumes.getLastRow()+1,[work.title,b.editionTitle,b.number,b.date?Math.floor(Date.parse(b.date+'T00:00:00Z')/86400000)+25569:'',null,b.publisher,b.kind==='novel'?'Novel':'Manga','',b.date?'Da calendario':'Da verificare',b.url,id,(b.url.match(/\/edizione\/(\d+)/)||[])[1]||'',work.url||'','Acquisto registrato con il carrello Yume il '+b.purchasedAt+(b.isbn?' · ISBN '+b.isbn:''),''],requests)}
 if(index<0){row_(works,row,[work.title,'Da verificare',work.owned,null,work.numbers,null,null,work.publisher,'','',null,work.original,work.english,work.animeclick||'',work.url||'',id,'Carrello Yume',work.author||'Autore e metadati non disponibili: da verificare',work.bibliographicSource||b.url],requests)}
 else if(!already){
  const current=rows[index],ownedFormula=works.getRange(row,3).getFormula(),totalFormula=works.getRange(row,7).getFormula();if(ownedFormula&&!/^=COUNTIF\(/i.test(ownedFormula))throw Error('Formula dei posseduti da verificare.');
  requests.push(cell_(works,row,3,ownedFormula?formula_("=COUNTIF('Volumi in possesso'!$K$2:$K;$P"+row+")"):value_((Number(current[2])||0)+1)));
  const numbers=String(current[4]||'').trim(),added=b.number+(b.language==='EN'?' (EN)':'');requests.push(cell_(works,row,5,value_(numbers?[...new Set(numbers.split(/,\s*/).concat(added))].join(', '):added)));
  if(totalFormula&&/^=SUMIF\(/i.test(totalFormula))requests.push(cell_(works,row,7,formula_("=SUMIF('Volumi in possesso'!$K$2:$K;$P"+row+";'Volumi in possesso'!$E$2:$E)")));
 }
 row_(log,log.getLastRow()+1,[request.requestId,b.key,b.purchasedAt,JSON.stringify(b),work.title],requests);
 const response=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+ss.getId()+':batchUpdate',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},payload:JSON.stringify({requests}),muteHttpExceptions:true});if(response.getResponseCode()!==200)throw Error('Aggiornamento non riuscito; nessun acquisto applicato.');SpreadsheetApp.flush();return {...b,requestId:request.requestId};
}
