/* Owner-authorized anime writes. Public readers receive only verified catalogue metadata and view states. */
const YUME_ANIME_LOG='Visioni Yume';
function animeLog_(){const ss=sheet_();let sh=ss.getSheetByName(YUME_ANIME_LOG);if(!sh){sh=ss.insertSheet(YUME_ANIME_LOG);sh.getRange(1,1,1,5).setValues([['ID operazione','Anime ID','Aggiornato il','Visione e metadati pubblici','Anime']]);sh.setFrozenRows(1);sh.getRange(1,1,1,5).setBackground('#202236').setFontColor('#ffffff').setFontWeight('bold');sh.setColumnWidths(1,3,180);sh.setColumnWidth(4,350);sh.setColumnWidth(5,280)}return sh}
function animeRecords_(){const sh=sheet_().getSheetByName(YUME_ANIME_LOG),latest={};if(sh&&sh.getLastRow()>1)for(const row of sh.getRange(2,1,sh.getLastRow()-1,5).getValues()){try{const r=JSON.parse(row[3]);if(/^anime-\d+$/.test(r.id))latest[r.id]=r}catch{}}return Object.values(latest)}
function animeAuthorized_(token){const key=PropertiesService.getScriptProperties().getProperty('OWNER_KEY');if(!key||typeof token!=='string'||token.length!==key.length)return false;let diff=0;for(let i=0;i<key.length;i++)diff|=key.charCodeAt(i)^token.charCodeAt(i);return diff===0}
function doGet(e){const q=e.parameter||{};if(q.action==='anime-catalog'){try{return output_({status:'ok',version:1,records:animeRecords_()},q.callback)}catch{return output_({status:'unavailable',records:[]},q.callback)}}if(q.action==='anime-capabilities')return output_({status:'ok',version:1,ownerAnime:true},q.callback);return legacyYumeGet(e)}
function doPost(e){let request;try{request=JSON.parse(e.postData.contents);if(!['anime-save','verify-anime-owner'].includes(request.action))return legacyYumePost(e);if(!animeAuthorized_(request.token))return output_({status:'denied'});if(!/^[a-f0-9-]{36}$/.test(request.requestId||''))throw Error('Operazione non valida.');if(request.action==='verify-anime-owner'){const result={status:'ok',owner:true};CacheService.getScriptCache().put('metadata:'+request.requestId,JSON.stringify(result),600);return output_(result)}const lock=LockService.getScriptLock();lock.waitLock(30000);try{const result=saveAnime_(request);CacheService.getScriptCache().put('metadata:'+request.requestId,JSON.stringify({status:'ok',record:{id:result.id,requestId:result.requestId}}),600);return output_({status:'ok'})}finally{lock.releaseLock()}}catch(err){if(animeAuthorized_(request?.token)&&/^[a-f0-9-]{36}$/.test(request?.requestId||''))CacheService.getScriptCache().put('error:'+request.requestId,'Visione non sincronizzata: '+String(err.message||'errore').slice(0,180),600);return output_({status:'error'})}}
function animeStatus_(s){return s.ownerState==='completed'?'Completato':s.ownerState==='onair'||s.progress>0?'In corso':'Da vedere'}
function saveAnime_(request){
 const a=request.anime||{};if(!/^anime-\d+$/.test(a.id||'')||!['watch','onair','completed'].includes(a.ownerState)||!Number.isInteger(a.progress)||a.progress<0||a.progress>100000||!(a.rating===null||Number.isInteger(a.rating)&&a.rating>=1&&a.rating<=10))throw Error('Anime, stato, episodi o voto non validi.');
 const previous=animeRecords_(),logSheet=sheet_().getSheetByName(YUME_ANIME_LOG);if(logSheet&&logSheet.getLastRow()>1){const receipt=logSheet.getRange(2,1,logSheet.getLastRow()-1,5).getValues().find(row=>row[0]===request.requestId);if(receipt)return JSON.parse(receipt[3]);}
 const malId=Number(a.id.slice(6)),library=fetchJson_('library.json').items,base=library.find(x=>x.type==='anime'&&Number(x.malId)===malId),seasonal=fetchJson_('seasons.json').items[a.id];if(!base&&!seasonal)throw Error('Anime non presente nelle fonti del catalogo.');
 const metadata={...base,...seasonal,id:base?.id||a.id,type:'anime',malId,total:Number(seasonal?.episodes||base?.total)||0,original:seasonal?.japanese||base?.original||'',synopsis:seasonal?.synopsisIt||base?.synopsis||'',streamingOffers:seasonal?.streaming||base?.streamingOffers||[],streaming:base?.streaming||'',genres:seasonal?.genres||base?.genres||[],favorite:base?.favorite||false};
 const total=metadata.total;if(total>0&&a.progress>total)throw Error('Episodi oltre il totale verificato.');const stamp=new Date().toISOString(),record={id:a.id,malId,ownerState:a.ownerState,progress:a.ownerState==='completed'&&total>0?total:a.progress,rating:a.rating,total,updatedAt:stamp,requestId:request.requestId,metadata};record.status=animeStatus_(record);
 const changed=[];if(record.ownerState==='onair')for(const r of previous)if(r.id!==record.id&&r.ownerState==='onair'){const demoted={...r,ownerState:'watch',updatedAt:stamp,requestId:request.requestId+'-previous'};demoted.status=animeStatus_(demoted);changed.push(demoted)}changed.push(record);
 const ss=sheet_(),anime=ss.getSheetByName('Anime'),series=ss.getSheetByName('Serie e stagioni');if(!anime||!series)throw Error('Schede Anime e Serie e stagioni mancanti.');
 const rows=anime.getRange(2,1,Math.max(1,anime.getLastRow()-1),44).getValues(),seriesRows=series.getRange(2,1,Math.max(1,series.getLastRow()-1),9).getValues(),requests=[];let nextAnime=anime.getLastRow()+1,nextSeries=series.getLastRow()+1;
 for(const r of changed){const m=r.metadata,found=rows.map((v,i)=>({v,row:i+2})).filter(x=>Number(x.v[26])===r.malId||String(x.v[10]).includes('/anime/'+r.malId+'/'));if(found.length>1)throw Error('Più righe per lo stesso anime: verifica manuale necessaria.');let row=found[0]?.row;
  if(row){requests.push(cell_(anime,row,4,value_(r.status)),cell_(anime,row,5,value_(r.rating)),cell_(anime,row,8,value_(r.progress)));if(r.total>0)requests.push(cell_(anime,row,9,value_(r.total)))}else{row=nextAnime++;const v=Array(44).fill('');v[0]=false;v[1]=m.title;v[2]=({TV:'Serie',Movie:'Film',ONA:'Serie web',OVA:'OVA',Special:'Speciale'})[m.format]||m.format||'Serie';v[3]=r.status;v[4]=r.rating;v[7]=r.progress;v[8]=r.total||null;v[9]='Visione registrata da Xuthar dal sito Yume';v[10]=m.url||'';v[11]=m.original||'';v[12]=m.english||'';v[13]=m.italian||'';v[14]=m.source||'';v[26]=r.malId;v[27]=m.franchiseId||'seasonal-'+r.malId;v[28]=m.franchiseTitle||m.title;v[29]=m.seasonCategory||'Stagioni e serie';v[31]=m.releaseYear||Number(String(m.releaseDate||'').slice(0,4))||'';v[32]=m.studio||'';v[33]=m.synopsis||'';v[34]=m.image||'';v[38]=m.url||'';v[40]=m.streamingSource||'';v[41]=(m.streamingOffers||[]).map(x=>x.name).join(', ');v[42]='Dettagli ulteriori disponibili nella scheda sul sito; non dedotti.';v[43]=r.total||null;row_(anime,row,v,requests)}
  const sm=seriesRows.map((v,i)=>({v,row:i+2})).filter(x=>String(x.v[8]).includes('/anime/'+r.malId+'/'));if(sm.length>1)throw Error('Più righe nella lista stagioni.');if(sm.length){const n=sm[0].row;requests.push(cell_(series,n,4,value_(r.status)),cell_(series,n,5,value_(r.rating)),cell_(series,n,6,value_(r.progress)));if(r.total>0)requests.push(cell_(series,n,7,value_(r.total)))}else row_(series,nextSeries++,[m.franchiseTitle||m.title,m.title,m.seasonCategory||'Stagioni e serie',r.status,r.rating,r.progress,r.total||null,m.english||'',m.url||''],requests);
 }
 const log=animeLog_();let nr=log.getLastRow()+1;for(const r of changed)row_(log,nr++,[r.requestId,r.id,r.updatedAt,JSON.stringify(r),r.metadata.title],requests);
 for(const [name,status] of [['Completati','Completato'],['Da vedere','Da vedere']]){const sh=ss.getSheetByName(name);if(!sh)continue;const formula=sh.getRange('A2').getFormula();if(/^=IFNA\(FILTER\(Anime!/i.test(formula)){const end=Math.max(anime.getMaxRows(),nextAnime-1);requests.push(cell_(sh,2,1,formula_('=IFNA(FILTER(Anime!A2:Q'+end+';Anime!B2:B'+end+'<>"";Anime!D2:D'+end+'="'+status+'");"")')))}}
 const response=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+ss.getId()+':batchUpdate',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},payload:JSON.stringify({requests}),muteHttpExceptions:true});if(response.getResponseCode()!==200)throw Error('Salvataggio non applicato.');SpreadsheetApp.flush();return record;
}
function verifyYumeAnimeSetup(){requireOwner_();const ss=sheet_();if(!ss.getSheetByName('Anime')||!ss.getSheetByName('Serie e stagioni'))throw Error('Schede anime mancanti.');animeLog_();console.log('Registro visioni pronto. Nessun episodio, voto o stato modificato.');return true}
